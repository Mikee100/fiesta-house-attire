# SAFE TEMPLATE ONLY
# Do NOT put real secrets in this file. Copy to backend/.env and fill real values there.

# Backend runtime
NODE_ENV=development
PORT=5000

# Database
# Example local URL: postgres://postgres:postgres@localhost:5432/fiesta_house
DATABASE_URL=postgres://<db-user>:<db-password>@<db-host>:<db-port>/<db-name>
DATABASE_SSL=false

# Allowed frontend origins (comma-separated)
# Example: http://localhost:5173,https://fiestahouseattire.vercel.app,https://app.fiestahouseattire.com
CORS_ORIGINS=http://localhost:5173,https://fiestahouseattire.vercel.app,https://app.fiestahouseattire.com

# JWT secrets (generate long random strings; never reuse across environments)
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Admin seed user (use temporary values and rotate immediately after first login)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-temporary-strong-password
ADMIN_SEED_NAME=Admin User

# Supabase storage (required for upload endpoints)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=replace-with-supabase-service-role-key

# SMTP (required for order email notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASS=replace-with-smtp-app-password
